# ==============================================================================
# ROWAD DIGITAL — ENVIRONMENT CONFIGURATION
# مؤسسة رواد الرقمية للدعاية والإعلان
# ==============================================================================

# Core App
NEXT_PUBLIC_SITE_URL=https://rowaddigital.sa
NEXT_PUBLIC_CONTACT_PHONE=+966541430116
NEXT_PUBLIC_WHATSAPP_NUMBER=+966543907572
NEXT_PUBLIC_CONTACT_EMAIL=info@rowaddigital.sa

# MongoDB Atlas (Required for Phase 3 Leads & Sales Storage)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rowad_db?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secret for Admin Dashboard (Phase 3)
# Generate a strong random 32+ char string (e.g. openssl rand -base64 32)
AUTH_SECRET=
ADMIN_EMAIL=admin@rowaddigital.sa
ADMIN_INITIAL_PASSWORD=

# Transactional Email Notification (Resend / SMTP)
# Used for instant email alerts when a lead submits the form
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=leads@rowaddigital.sa

# Tracking & Ad Pixels (Client Side - Loaded only after user consent)
# Leave empty if not yet active; system gracefully skips unconfigured pixels
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Server-Side Conversions API (CAPI) Secrets (Phase 4 - Never expose to client)
META_CAPI_ACCESS_TOKEN=
TIKTOK_EVENTS_API_ACCESS_TOKEN=
SNAPCHAT_CAPI_ACCESS_TOKEN=

